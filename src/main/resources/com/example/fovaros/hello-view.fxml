<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fovaros.HelloController">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Fájl">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onMegnyitasClick" text="Megnyitás" />
              <MenuItem mnemonicParsing="false" onAction="#OnBezar" text="Bezár" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Súgó">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onNevjegyClick" text="Névjegy" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox spacing="10.0">
         <children>
            <ListView fx:id="lsLista" onMousePressed="#OnList" prefHeight="300.0" prefWidth="300.0" />
            <VBox spacing="10.0">
               <children>
                  <Label text="Fovaros" />
                  <TextField fx:id="fovarosTF" />
                  <Label layoutX="10.0" layoutY="10.0" text="Fovaros Lakossaga" />
                  <TextField fx:id="fovaroslakossagTF" layoutX="10.0" layoutY="27.0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
